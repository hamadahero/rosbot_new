<?xml version="1.0"?>
<robot name="six_axis" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:ros2_control="http://www.ros.org/wiki/ros2_control">

  <!-- Materials -->
  <material name="gray">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.9 0.9 0.98 1.0"/>
  </material>

  <!-- ======================= -->
  <!-- Base and Joints         -->
  <!-- ======================= -->

  <!-- Base -->
  <link name="base_link_arm"/>

  <joint name="j0" type="fixed">
    <parent link="base_link_arm"/>
    <child link="l0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- l0 -->
  <link name="l0">
    <inertial>
      <origin xyz="0 0 0.0125"/>
      <mass value="0.4"/> 
      <inertia ixx="0.000938" iyy="0.001424" izz="0.001766"
               ixy="0" ixz="0.000238" iyz="0"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.05" length="0.025"/></geometry>
      <origin xyz="0 0 0"/>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.025"/></geometry>
      <origin xyz="0 0 0"/>
    </collision>
  </link>

  <joint name="j1" type="revolute">
    <parent link="l0"/>
    <child link="l1"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.283" upper="6.283" effort="2" velocity="0.8"/>
  </joint>

  <!-- Transmission for j1 -->
  <transmission name="trans_j1">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="j1">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="actuator_j1">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </actuator>
  </transmission>

  <!-- l1 -->
  <link name="l1">
    <inertial>
      <origin xyz="0 0 0.125"/>
      <mass value="0.2"/>
      <inertia ixx="0.0138" iyy="0.0139" izz="0.0035"
               ixy="1.03e-06" ixz="4.23e-05" iyz="0.0023"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.015" length="0.1"/></geometry>
      <origin xyz="0 0 0.05"/>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="0.1"/></geometry>
      <origin xyz="0 0 0.05"/>
    </collision>
    <visual>
      <geometry><sphere radius="0.0175"/></geometry>
      <origin xyz="0 0 0.1"/>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="j_dummy_1_2" type="fixed">
    <parent link="l1"/>
    <child link="l2"/>
    <origin xyz="0 0 0.1"/>
  </joint>

  <!-- l2 -->
  <link name="l2">
    <inertial>
      <origin xyz="0.125 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.03" iyy="0.398" izz="0.348" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.015" length="0.125"/></geometry>
      <origin xyz="0.0625 0 0" rpy="0 ${pi/2} 0"/>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="0.125"/></geometry>
      <origin xyz="0.0625 0 0" rpy="0 ${pi/2} 0"/>
    </collision>
    <visual>
      <geometry><sphere radius="0.0175"/></geometry>
      <origin xyz="0.125 0 0"/>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="j2" type="revolute">
    <parent link="l2"/>
    <child link="l3"/>
    <origin xyz="0.125 0 0" rpy="0 ${pi/2} 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="2" velocity="0.8"/>
  </joint>

  <!-- Transmission for j2 -->
  <transmission name="trans_j2">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="j2">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="actuator_j2">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </actuator>
  </transmission>

  <!-- l3 -->
  <link name="l3">
    <inertial>
      <origin xyz="-0.075 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.015" length="0.15"/></geometry>
      <origin xyz="-0.075 0 0" rpy="0 ${pi/2} 0"/>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="0.15"/></geometry>
      <origin xyz="-0.075 0 0" rpy="0 ${pi/2} 0"/>
    </collision>
    <visual>
      <geometry><sphere radius="0.0175"/></geometry>
      <origin xyz="0 0 0"/>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="j3" type="revolute">
    <parent link="l3"/>
    <child link="l4"/>
    <origin xyz="-0.15 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="2" velocity="0.8"/>
  </joint>

  <!-- Transmission for j3 -->
  <transmission name="trans_j3">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="j3">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="actuator_j3">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </actuator>
  </transmission>

  <!-- l4 -->
  <link name="l4">
    <inertial>
      <origin xyz="0 0 -0.06"/>
      <mass value="0.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.015" length="0.12"/></geometry>
      <origin xyz="0 0 -0.06"/>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="0.12"/></geometry>
      <origin xyz="0 0 -0.06"/>
    </collision>
    <visual>
      <geometry><sphere radius="0.0175"/></geometry>
      <origin xyz="0 0 0"/>
      <material name="gray"/>
    </visual>
  </link>

  <joint name="j_dummy" type="fixed">
    <parent link="l4"/>
    <child link="l5"/>
    <origin xyz="0 0 -0.12"/>
  </joint>

  <!-- l5 -->
  <link name="l5">
    <inertial>
      <origin xyz="-0.08 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.015" length="0.16"/></geometry>
      <origin xyz="-0.08 0 0" rpy="0 ${pi/2} 0"/>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="0.16"/></geometry>
      <origin xyz="-0.08 0 0" rpy="0 ${pi/2} 0"/>
    </collision>
  </link>

  <joint name="j4" type="revolute">
    <parent link="l5"/>
    <child link="l6"/>
    <origin xyz="-0.16 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="2" velocity="0.8"/>
  </joint>

  <!-- Transmission for j4 -->
  <transmission name="trans_j4">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="j4">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="actuator_j4">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </actuator>
  </transmission>

  <!-- l6 -->
  <link name="l6">
    <inertial>
      <origin xyz="0 0 0.0625"/>
      <mass value="0.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.015" length="0.125"/></geometry>
      <origin xyz="0 0 0.0625"/>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="0.125"/></geometry>
      <origin xyz="0 0 0.0625"/>
    </collision>
  </link>

  <!-- Transmission for j6 -->
  <transmission name="trans_j6">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="j6">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="actuator_j6">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </actuator>
  </transmission>

  <!-- Gazebo plugin -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so"/>
  </gazebo>

</robot>

